{
  "storeDir": "/home/tabula-backup/store",
  "stateDir": "/home/tabula-backup/state",
  "pullMasterFile": "/etc/tabula-backup/pull-master",
  "workspacesFile": "/home/tabula-backup/state/workspaces.json",
  "prefix": "tabula",
